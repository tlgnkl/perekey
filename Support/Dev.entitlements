<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Development and ad hoc builds only (scripts/bundle.sh): their signatures have
     no team ID, so library validation would refuse the embedded Sparkle.framework.
     Developer ID builds are signed without this file. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
