<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Finder's «Open With» offers Perekey for audio and video, which a voice build transcribes.
	     Alternate: it never becomes the default player. Other builds ignore the files. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Matroska and WebM</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>mkv</string>
				<string>mka</string>
				<string>webm</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>Perekey</string>
	<key>CFBundleIdentifier</key>
	<string>app.perekey.Perekey</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ru</string>
	</array>
	<key>CFBundleName</key>
	<string>Perekey</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<!-- perekey://pause, resume, autoswitch, mode: harmless actions only (ControlCommand.swift). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.perekey.Perekey</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>perekey</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- AppleScript: Support/Perekey.sdef, copied by scripts/bundle.sh. -->
	<key>NSAppleScriptEnabled</key>
	<true/>
	<key>OSAScriptingDefinition</key>
	<string>Perekey.sdef</string>
	<!-- Voice input. Shown by macOS when the app first asks; translated in
	     Support/*.lproj/InfoPlist.strings (scripts/check-strings.sh). -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Perekey listens to the microphone only while you dictate or record a call.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Perekey records the other side of a call from the system audio, only while you record the call.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Perekey connects to a language model on your network, such as Ollama, only if you set one up.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Perekey contributors. Licensed under GPL-3.0-or-later.</string>
	<!-- Sparkle 2. The only network address of the app; README, "Network", names it. -->
	<key>SUFeedURL</key>
	<string>https://tlgnkl.github.io/perekey/appcast.xml</string>
	<!-- The EdDSA public key that checks every update (docs/release.md). The private
	     key is the CI secret SPARKLE_ED_PRIVATE_KEY. Without a real key the app treats
	     updates as not set up and never starts Sparkle. -->
	<key>SUPublicEDKey</key>
	<string>ogG6ALB7tkGKrhNl2hH/zDjlXeDH78uQZ6jOyjo2/Xg=</string>
	<!-- On by default, without Sparkle's permission prompt; the user turns it off in Settings → General. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<!-- No anonymous system profile, ever. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
	<!-- The user sees each update before it installs. -->
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
	<!-- Every update must carry the EdDSA signature of SUPublicEDKey, checked before
	     Sparkle unpacks it. Without this Sparkle also takes an update with a new key when
	     its code signature matches, so the self-signed "Perekey Release" certificate
	     alone could ship one (docs/release.md, "Signing"). -->
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<!-- Voice: OpenAI-compatible servers in the local network (Ollama, LM
	     Studio on another Mac) speak plain http. Only local hosts are
	     exempt; every other request keeps App Transport Security. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
