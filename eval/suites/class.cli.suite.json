{
 "about": "Commands, flags and paths of the tldr-pages examples, one token each",
 "class": {
  "corpus": "tldr/tldr-pages.en.zip",
  "rule": "cli",
  "seeds": "class.cli.txt"
 },
 "end": "space",
 "epoch": 1,
 "layoutSets": [
  [
   "ABC",
   "Russian"
  ]
 ],
 "license": "tldr-pages CC BY 4.0 (v2.3); wordfreq CC BY-SA 4.0 + Hunspell/SCOWL (data/SOURCES.md); sentences to warm up with: Tatoeba CC BY 2.0 FR (part CC0)",
 "reader": "class",
 "sampling": "type",
 "scenarios": [
  "clean.cold",
  "clean.warm"
 ],
 "seed": 1,
 "settings": "default",
 "source": "tatoeba/rus_sentences.tsv.bz2,tatoeba/eng_sentences.tsv.bz2",
 "split": {
  "by": "unit",
  "dev": 50
 },
 "suite": "class.cli",
 "tags": [
  "class",
  "cli"
 ],
 "tiers": {
  "ci": 800,
  "full": 20000
 },
 "version": 1
}
